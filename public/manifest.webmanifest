{
  "name": "Personal OS",
  "short_name": "Personal OS",
  "description": "Journal, notas, tareas, hábitos y foco. Privado y en tu iPhone.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
